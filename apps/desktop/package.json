{
  "name": "@arareader/desktop",
  "productName": "ARAReader",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "ARAReader desktop host: PDF tabs, home, menus, and window lifecycle",
  "main": "out/main/index.js",
  "desktopName": "arareader.desktop",
  "scripts": {
    "dev": "node scripts/dev.cjs dev",
    "build": "electron-vite build",
    "start": "node scripts/dev.cjs start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:win": "electron-builder --config electron-builder.cjs --win --publish never",
    "dist:mac": "electron-builder --config electron-builder.cjs --mac --publish never",
    "dist:linux": "electron-builder --config electron-builder.cjs --linux --publish never"
  },
  "devDependencies": {
    "@arareader/agent-core": "*",
    "@arareader/ai-provider": "*",
    "@arareader/ai-search": "*",
    "@arareader/electron-utils": "*",
    "@arareader/file-parse": "*",
    "@arareader/i18n": "*",
    "@arareader/project-store": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "Adhi Rahmadian",
  "homepage": "https://github.com/funara/arareader"
}
